# --- Build output ---
/build/
/cmake-build-*/
build*/

# --- CMake local overrides (machine-specific toolchains live here, never committed) ---
CMakeUserPresets.json

# --- M12-C C1b third-party distfiles (local dependency bytes; the tracked truth is the
#     lock manifest third_party/m12c-c1b/dependencies.lock.json, never the blobs) ---
/third_party/m12c-c1b/distfiles/

# --- IDE / editor ---
.vscode/
.idea/
*.user
.cache/
.clangd/
compile_commands.json

# --- Compiler / linker artifacts ---
*.o
*.obj
*.exe
*.dll
*.dylib
*.so
*.a
*.lib
*.pdb

# --- OS noise ---
.DS_Store
Thumbs.db
# --- Deployment diagnostic temp files ---
build/deploy_err*.txt
build/deploy_out*.txt

# --- Benchmark generated samples (reproducible via scripts/bench_replay/gen_samples.py) ---
scripts/bench_replay/out/
__pycache__/
